{
  "name": "server",
  "private": true,
  "packageManager": "npm@10.9.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "tsx watch src/main.ts",
    "dev:composer": "npm run build && npm run composer:dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "node dist/server.mjs",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/composer": "0.17.0",
    "@prisma/composer-prisma-cloud": "0.17.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "alchemy": "2.0.0-beta.74",
    "bcrypt": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.4",
    "winston": "^3.19.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prisma": "latest",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  }
}
