# APP
PORT=3000
NODE_ENV=development
PUBLIC_API_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Required in production; use a hop count or comma-separated trusted proxy CIDRs.
# TRUST_PROXY=1

# DATABASE
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/backend

# JWT
JWT_ACCESS_TOKEN=replace-with-a-distinct-access-token-secret
JWT_REFRESH_TOKEN=replace-with-a-distinct-refresh-token-secret
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=30d
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRE=90d
BCRYPT_ROUNDS=12
RATE_LIMIT_SOURCE_HMAC_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Optional newline-delimited additional denylist. The bundled top-10,000 list is always active.
# PASSWORD_DENYLIST_PATH=/run/secrets/common-passwords.txt

# IMAGEKIT (must be enabled and fully configured in production)
IMAGEKIT_ENABLED=false
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_account
IMAGEKIT_UPLOAD_FOLDER=/tooang

# OPTIONAL SUPER ADMIN BOOTSTRAP
# SEED_SUPER_ADMIN_EMAIL=admin@example.com
# SEED_SUPER_ADMIN_PASSWORD=change-this-password
# SEED_SUPER_ADMIN_FULL_NAME=Super Administrator

# CACHE
CACHE_TTL=60
CACHE_REDIS_URL=redis://localhost:6379
