// Digital food menu, RBAC, reviews, carts, and cashier-verifiable orders.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PlaceMemberRole {
  OWNER
  CASHIER
}

enum PlaceType {
  RESTAURANT
  CAFE
  FOOD_STALL
  OTHER
}

enum MenuItemType {
  FOOD
  DRINK
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FulfillmentType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MediaAssetStatus {
  ACTIVE
  PENDING_DELETE
  DELETE_FAILED
  DELETED
}

model User {
  id                  String           @id @default(uuid())
  userId              String           @unique @map("id_user")
  fullName            String           @map("full_name")
  email               String           @unique @db.VarChar(254)
  passwordHash        String           @map("password_hash")
  platformRole        PlatformRole     @default(USER) @map("platform_role")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")
  deletionRequestedAt DateTime?        @map("deletion_requested_at")
  anonymizedAt        DateTime?        @map("anonymized_at")
  placeMemberships    PlaceMember[]
  placeReviews        PlaceReview[]
  menuItemReviews     MenuItemReview[]
  carts               Cart[]
  orders              Order[]
  idempotencyKeys     IdempotencyKey[]
  refreshSessions     RefreshSession[]
  auditLogs           AuditLog[]       @relation("AuditActor")

  @@index([platformRole, deletedAt])
  @@index([deletedAt, createdAt])
  @@index([deletionRequestedAt])
  @@map("users")
}

model RefreshSession {
  id           String          @id @default(uuid())
  familyId     String          @map("family_id")
  userId       String          @map("user_id")
  tokenHash    String          @unique @map("token_hash")
  expiresAt    DateTime        @map("expires_at")
  revokedAt    DateTime?       @map("revoked_at")
  replacedById String?         @unique @map("replaced_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("SessionReplacement")

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model Place {
  id                String         @id @default(uuid())
  name              String         @db.VarChar(120)
  slug              String         @unique @db.VarChar(100)
  type              PlaceType
  description       String?        @db.VarChar(2000)
  address           String         @db.VarChar(500)
  city              String?        @db.VarChar(100)
  latitude          Decimal?       @db.Decimal(10, 7)
  longitude         Decimal?       @db.Decimal(10, 7)
  phone             String?        @db.VarChar(30)
  whatsapp          String?        @db.VarChar(30)
  timezone          String
  logoAssetId       String?        @unique @map("logo_asset_id")
  coverAssetId      String?        @unique @map("cover_asset_id")
  isPublished       Boolean        @default(false) @map("is_published")
  isOrderingEnabled Boolean        @default(false) @map("is_ordering_enabled")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")
  members           PlaceMember[]
  businessHours     BusinessHour[]
  diningTables      DiningTable[]
  categories        MenuCategory[]
  menuItems         MenuItem[]
  reviews           PlaceReview[]
  carts             Cart[]
  orders            Order[]
  logoAsset         MediaAsset?    @relation("PlaceLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  coverAsset        MediaAsset?    @relation("PlaceCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([isPublished, deletedAt, createdAt])
  @@index([type, isPublished, deletedAt])
  @@map("places")
}

model PlaceMember {
  id        String          @id @default(uuid())
  placeId   String          @map("place_id")
  userId    String          @map("user_id")
  role      PlaceMemberRole
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  revokedAt DateTime?       @map("revoked_at")
  place     Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([placeId, userId])
  @@index([placeId, revokedAt, role])
  @@index([userId, revokedAt, role])
  @@map("place_members")
}

model BusinessHour {
  id       String    @id @default(uuid())
  placeId  String    @map("place_id")
  day      DayOfWeek
  opensAt  DateTime? @map("opens_at") @db.Time(0)
  closesAt DateTime? @map("closes_at") @db.Time(0)
  isClosed Boolean   @default(false) @map("is_closed")
  place    Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, day])
  @@map("business_hours")
}

model DiningTable {
  id             String    @id @default(uuid())
  placeId        String    @map("place_id")
  name           String    @db.VarChar(30)
  normalizedName String    @map("normalized_name") @db.VarChar(30)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  place          Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([placeId, normalizedName])
  @@index([placeId, isActive, deletedAt])
  @@map("dining_tables")
}

model MediaAsset {
  id                 String           @id @default(uuid())
  imageKitFileId     String           @unique @map("imagekit_file_id")
  deliveryUrl        String           @map("delivery_url")
  deliveryPath       String?          @map("delivery_path")
  mimeType           String           @map("mime_type") @db.VarChar(50)
  sizeBytes          Int              @map("size_bytes")
  status             MediaAssetStatus @default(ACTIVE)
  cleanupAttempts    Int              @default(0) @map("cleanup_attempts")
  cleanupLastError   String?          @map("cleanup_last_error")
  cleanupRequestedAt DateTime?        @map("cleanup_requested_at")
  cleanupCompletedAt DateTime?        @map("cleanup_completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  logoForPlace       Place?           @relation("PlaceLogo")
  coverForPlace      Place?           @relation("PlaceCover")
  menuItem           MenuItem?

  @@index([status, cleanupRequestedAt])
  @@map("media_assets")
}

model MenuCategory {
  id             String     @id @default(uuid())
  placeId        String     @map("place_id")
  name           String     @db.VarChar(100)
  normalizedName String     @map("normalized_name") @db.VarChar(100)
  description    String?
  sortOrder      Int        @default(0) @map("sort_order")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  place          Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]

  @@unique([placeId, normalizedName])
  @@index([placeId, isActive, deletedAt, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String           @id @default(uuid())
  placeId      String           @map("place_id")
  categoryId   String           @map("category_id")
  name         String           @db.VarChar(120)
  description  String?          @db.VarChar(1000)
  type         MenuItemType
  price        Decimal          @db.Decimal(15, 2)
  imageAssetId String?          @unique @map("image_asset_id")
  isAvailable  Boolean          @default(true) @map("is_available")
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  place        Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category     MenuCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageAsset   MediaAsset?      @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  reviews      MenuItemReview[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([placeId, type, isAvailable, deletedAt])
  @@index([categoryId, isAvailable, deletedAt])
  @@map("menu_items")
}

model PlaceReview {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  placeId   String    @map("place_id")
  orderId   String    @unique @map("order_id")
  rating    Int
  comment   String?   @db.VarChar(2000)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([placeId, deletedAt, createdAt])
  @@index([userId, createdAt])
  @@map("place_reviews")
}

model MenuItemReview {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  menuItemId String    @map("menu_item_id")
  orderId    String    @map("order_id")
  rating     Int
  comment    String?   @db.VarChar(2000)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, menuItemId])
  @@index([menuItemId, deletedAt, createdAt])
  @@index([userId, createdAt])
  @@map("menu_item_reviews")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  placeId   String     @map("place_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId, placeId])
  @@index([placeId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int      @default(1)
  note       String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([cartId, menuItemId])
  @@index([menuItemId])
  @@map("cart_items")
}

model Order {
  id                     String           @id @default(uuid())
  orderCode              String           @unique @map("order_code")
  verificationToken      String           @unique @default(uuid()) @map("verification_token")
  userId                 String           @map("user_id")
  placeId                String           @map("place_id")
  diningTableId          String?          @map("dining_table_id")
  status                 OrderStatus      @default(PENDING)
  statusUpdatedAt        DateTime         @default(now()) @map("status_updated_at")
  fulfillmentType        FulfillmentType  @default(DINE_IN) @map("fulfillment_type")
  customerName           String           @map("customer_name") @db.VarChar(100)
  diningTableName        String?          @map("dining_table_name") @db.VarChar(30)
  customerNote           String?          @map("customer_note") @db.VarChar(500)
  cancellationReason     String?          @map("cancellation_reason") @db.VarChar(500)
  subtotal               Decimal          @db.Decimal(15, 2)
  expiresAt              DateTime         @map("expires_at")
  verificationDisabledAt DateTime?        @map("verification_disabled_at")
  confirmedAt            DateTime?        @map("confirmed_at")
  completedAt            DateTime?        @map("completed_at")
  cancelledAt            DateTime?        @map("cancelled_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  user                   User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  place                  Place            @relation(fields: [placeId], references: [id], onDelete: Restrict)
  diningTable            DiningTable?     @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  placeReview            PlaceReview?
  menuItemReviews        MenuItemReview[]

  @@index([userId, createdAt])
  @@index([placeId, status, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  menuItemId String?      @map("menu_item_id")
  itemName   String       @map("item_name")
  itemType   MenuItemType @map("item_type")
  unitPrice  Decimal      @map("unit_price") @db.Decimal(15, 2)
  quantity   Int
  note       String?      @db.VarChar(500)
  lineTotal  Decimal      @map("line_total") @db.Decimal(15, 2)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String
  userId         String   @map("user_id")
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
